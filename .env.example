# Postgres — Supabase: Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# YouTube Data API v3 key (server only)
YOUTUBE_API_KEY=

# Anthropic API key for the AI proposal drafter (server only)
ANTHROPIC_API_KEY=

# PayPal Sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Public URL used for PayPal return/cancel redirects (defaults to the request origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Password for /creator (shared access gate). Leave empty to disable.
CREATOR_PASSWORD=judgesonly
